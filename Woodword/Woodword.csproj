<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.3.0.0</Version>
    <Author>Lynnaes Krasikaz</Author>
    <RepoUrl>https://github.com/kaerlath/Woodword</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/kaerlath/Woodword/main/images/icon.png</IconUrl>
    <Name>Woodword</Name>
    <Punchline>Render words between Common and Vieran.</Punchline>
    <Description>A focused roleplay translation tool for Common and Vieran. Open it with /woodword. Woodword never intercepts or posts chat.</Description>
    <Tags>roleplay;translation;viera</Tags>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <WoodwordRelayToken>$(WOODWORD_RELAY_TOKEN)</WoodwordRelayToken>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="WoodwordRelayToken" Value="$(WoodwordRelayToken)" />
    <Content Include="Assets\woodword-background-v2.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\panel-top-botanical.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\panel-bottom-botanical.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Assets\raven-header-v3.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
